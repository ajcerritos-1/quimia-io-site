generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url intentionally omitted — Prisma 7 reads the datasource URL from
  // prisma.config.ts (DIRECT_DATABASE_URL, owner/migration role) for CLI
  // commands. The running app never reads a datasource URL from here; it
  // builds its own client with @prisma/adapter-pg against the pooled
  // DATABASE_URL (app role) in src/shared/db/client.ts (AD-2, D10).
}

// Phase 1 has exactly 3 fixed roles. RBAC tables (Role, per-user roleId) are
// deferred to Phase 2 (FR-70) — see ARCHITECTURE-SPINE.md AD-4 deferred list.
enum UserRole {
  admin
  recepcionista
  quimico
}

model Tenant {
  id        String   @id @default(cuid(2))
  slug      String   @unique // {lab}.quimiaio.com
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  // RLS-EXEMPT (D3): column-narrow GRANT SELECT(id, slug, isActive) only.
  // Do not add a tenant_isolation policy to this table — see rls_roles
  // migration and ARCHITECTURE-SPINE.md AD-2/AD-3.
  @@map("tenant")
}

model User {
  id            String   @id @default(cuid(2))
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String // NO bare @unique — multi-tenant uniqueness override (D4, AD-8)
  nickname      String // NO bare @unique — same override (D4, AD-8)
  name          String
  emailVerified Boolean  @default(false)
  image         String?
  role          UserRole
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Story 1.4 Task 3/4 (AC 2, NOM-024-SSA3 account lockout). Plain columns on
  // an already-RLS'd, already-granted table (rls_roles migration) — no new
  // policy/grant needed, see that migration's own comment. Reset to 0/null on
  // a successful sign-in; incremented on a failed one; `lockedUntil` set once
  // `failedLoginAttempts` reaches `MAX_FAILED_LOGIN_ATTEMPTS`
  // (`account-lockout.ts`).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  sessions Session[]
  accounts Account[]

  @@unique([tenantId, email])
  @@unique([tenantId, nickname])
  @@index([tenantId])
  // RLS + FORCE ROW LEVEL SECURITY (D5): tenant_isolation policy on
  // current_setting('app.tenant_id'). See rls_roles migration.
  @@map("user")
}

// Immutable audit trail (AD-10, NFR-7, Story 1.2 Task 1). "action" is a
// plain String, not an enum — action names keep growing across every later
// epic (2.4, 3.3, 6.2, 6.6, 7.4, ...); an enum here would need editing per
// module. Immutability is enforced at the Postgres GRANT level (SELECT +
// INSERT only, no UPDATE/DELETE to quimia_app — see the hand-written
// migration), not by application code, which could be bypassed by a bug or a
// future dev writing raw SQL.
model AuditLog {
  id          String   @id @default(cuid(2))
  tenantId    String
  entity      String
  entityId    String
  action      String
  before      Json?
  after       Json?
  actorUserId String
  createdAt   DateTime @default(now())

  @@index([tenantId])
  // Every "history of this record" query (including this story's own tests)
  // filters by entityId — code-review follow-up 2026-08-16.
  @@index([entityId])
  // RLS + FORCE ROW LEVEL SECURITY (D5, same shape as "user"): tenant_isolation
  // policy on current_setting('app.tenant_id'). See the hand-written migration.
  @@map("audit_log")
}

// ---- Supporting catalogs (Story 2.1) ----
// Catalog lookup tables Study (Story 2.2) references by FK. Tenant-owned
// (AD-2/AD-3): bare tenantId (AuditLog precedent), isActive
// (deactivate-never-delete), @@unique([tenantId, name]) (AD-8), RLS + FORCE
// via the catalog_supporting_models migration. Full CRUD grant to quimia_app
// (User precedent — deactivate-not-delete is an app rule, not a grant
// revocation; unlike audit_log's SELECT+INSERT-only).

model Method {
  id        String   @id @default(cuid(2))
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  // RLS + FORCE ROW LEVEL SECURITY (D5): tenant_isolation policy on
  // current_setting('app.tenant_id'). See catalog_supporting_models migration.
  @@map("method")
}

model Technique {
  id        String   @id @default(cuid(2))
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  // RLS + FORCE ROW LEVEL SECURITY (D5): tenant_isolation policy on
  // current_setting('app.tenant_id'). See catalog_supporting_models migration.
  @@map("technique")
}

model Equipment {
  id              String    @id @default(cuid(2))
  tenantId        String
  name            String
  model           String
  serialNumber    String // descriptive, not unique (proposal locked decision #4)
  calibrationDate DateTime? // nullable (FR-9: equipment may be uncalibrated)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  // RLS + FORCE ROW LEVEL SECURITY (D5): tenant_isolation policy on
  // current_setting('app.tenant_id'). See catalog_supporting_models migration.
  @@map("equipment")
}

model Container {
  id        String   @id @default(cuid(2))
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  // Catalog LOOKUP only (AD-6): list of container types a Study references
  // ("tubo lila EDTA"). No per-tube order/tube identity is modeled — that is
  // the entity AD-6 forbids (barcode identical across every tube of an order;
  // tube color is a phlebotomy draw-guide).
  // RLS + FORCE ROW LEVEL SECURITY (D5): tenant_isolation policy on
  // current_setting('app.tenant_id'). See catalog_supporting_models migration.
  @@map("container")
}

model SampleType {
  id        String   @id @default(cuid(2))
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  // RLS + FORCE ROW LEVEL SECURITY (D5): tenant_isolation policy on
  // current_setting('app.tenant_id'). See catalog_supporting_models migration.
  @@map("sample_type")
}

// Better Auth core tables — RLS-EXEMPT by design (AD-2 threat-model addendum,
// 2026-08-02). Do not add tenant_isolation policies to these three tables;
// isolation happens one hop later, at the User/application-data layer.
model Session {
  id        String   @id
  token     String   @unique
  userId    String
  tenantId  String // deliberate: lets middleware reject cross-tenant session replay
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  password              String? // credential hash lives HERE, not on User
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
