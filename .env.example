# Pooled connection (pgbouncer), used by the running app at runtime.
# Connects as the non-owner `quimia_app` role created by the rls_roles
# migration -- never the schema owner (AD-2, D10). RLS is enforced for this role.
DATABASE_URL="postgresql://quimia_app:<password>@<neon-pooled-host>/neondb?sslmode=require"

# Direct (unpooled) connection, used ONLY by the Prisma CLI (migrate, generate,
# provision-app-role script) and by prisma.config.ts. Connects as the schema
# owner/migration role. Never read by the running app at request time (AD-2, D10).
DIRECT_DATABASE_URL="postgresql://<owner-role>:<password>@<neon-direct-host>/neondb?sslmode=require"

# Set only if the runtime environment rejects Neon's TLS certificate against
# the system CA store. Must be set at process start (npm script / platform env
# var) -- it is read by Node before the process boots and cannot be set from
# application code. Never set `rejectUnauthorized: false` as a workaround
# (design.md "P1010 Mitigations").
# NODE_EXTRA_CA_CERTS=

# --- Test harness (Phase 3, PR 2) ---
# Neon API key with branch-management scope for this project. Used ONLY by
# tests/setup/neon-global-setup.ts to create/delete an ephemeral branch per
# test run (AD-9 test-time database addendum). Never used by the running app.
NEON_API_KEY=

# Neon project id and the parent branch every ephemeral test branch forks
# from. The parent should be a branch that already has both migrations
# (init, rls_roles) applied -- never point this at a branch you don't want
# test runs creating/deleting children of.
NEON_PROJECT_ID=
NEON_PARENT_BRANCH_ID=

# --- Better Auth (Phase 6, PR 4a) ---
# Signs/encrypts sessions and tokens (design.md "Better Auth Config"). Generate
# with: openssl rand -base64 32. Never reuse across environments.
BETTER_AUTH_SECRET=

# Root URL Better Auth issues cookies/links against. Local dev only — per-tenant
# subdomain base URLs are a later concern (no dynamic baseURL config in Phase 1).
BETTER_AUTH_URL=http://localhost:3000
